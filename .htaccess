DirectoryIndex login.php index.php
Options -Indexes

RewriteEngine On

# =========================================================
# ALLOW ONLY THIS SPECIFIC FILE
# =========================================================
RewriteRule ^user/ticket/includes/assign_request\.php$ - [L]

# =========================================================
# BLOCK SENSITIVE DIRECTORIES
# =========================================================
RewriteRule ^(?:config|includes|database|core|auth)(?:/|$) - [F,L]

# =========================================================
# BLOCK user/ticket/includes EXCEPT assign_request.php
# =========================================================
RewriteRule ^user/ticket/includes/(?!assign_request\.php$).* - [F,L]

# =========================================================
# CUSTOM ERROR PAGES
# =========================================================
ErrorDocument 403 /errors/403.php
ErrorDocument 404 /errors/404.php

# =========================================================
# TICKET FRIENDLY URL
# =========================================================
RewriteRule ^user/tickets/([0-9]+)$ user/ticket/view.php?ticket_id=$1 [L,QSA]